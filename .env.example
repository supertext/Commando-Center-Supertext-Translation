# Plugin Health settings (see docs/INSTALLATION.md). On Railway, set these as service variables.

# Postgres server. With COMMANDO_DB_NAME, the dashboard uses (and creates) its own database on it.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
COMMANDO_DB_NAME=commando

# Sign-in with Supertext accounts (Person Service, OIDC). Locally: node scripts/oidc-stand-in.mjs
# and COMMANDO_OIDC_ISSUER=http://127.0.0.1:8767/person.
COMMANDO_OIDC_ISSUER=https://www.supertext.com/person
COMMANDO_OIDC_CLIENT_ID=Supertext.PluginHealth
# At least 32 random characters (openssl rand -base64 48). Never commit the real one.
COMMANDO_SESSION_SECRET=
# Optional: COMMANDO_OIDC_CLIENT_SECRET=, COMMANDO_OIDC_ALLOWED_ROLES=Administrator,
# COMMANDO_OIDC_ALLOWED_EMAILS=@supertext.com, COMMANDO_PUBLIC_URL=https://commando.example


# Optional: GitHub token (read-only, public repos) for a higher API rate limit when reading releases.
# GITHUB_TOKEN=

# Optional: the Supertext translation proxy, for the "Translation proxy" tab (its REVIEW_USAGE_TOKEN as the token).
# COMMANDO_PROXY_URL=https://review-proxy.up.railway.app
# COMMANDO_PROXY_TOKEN=

# Optional: time zone for dates in the UI (default Europe/Zurich).
# COMMANDO_TIMEZONE=Europe/Zurich
