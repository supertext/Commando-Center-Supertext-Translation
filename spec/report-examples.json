{
  "description": "Example report bodies: 'valid' ones the center accepts (HTTP 202), 'invalid' ones it rejects (HTTP 400). 'stored' shows what the center keeps of api_key_check (with api_keys: their summary), api_key_configured, api_keys and callback where it matters. Shared with the SDKs' tests.",
  "valid": [
    {
      "name": "TYPO3 after saving the settings",
      "body": {
        "schema": 1,
        "event": "settings_saved",
        "site_url": "https://www.example.ch/",
        "plugin": {
          "name": "Typo3-Supertext-Translation",
          "version": "0.4.0"
        },
        "system": {
          "name": "TYPO3",
          "version": "13.4.2"
        },
        "runtime": {
          "name": "PHP",
          "version": "8.3.12"
        },
        "sdk_version": "0.3.0",
        "api_key_configured": true,
        "api_key_check": {
          "status": "ok",
          "checked_at": "2026-10-13T09:15:00+02:00",
          "http_status": 200
        },
        "callback": {
          "url": "https://www.example.ch/supertext/ping"
        }
      },
      "stored": {
        "api_key_check": {
          "status": "ok",
          "checked_at": "2026-10-13T07:15:00.000Z",
          "http_status": 200,
          "error_code": null
        },
        "callback_url": "https://www.example.ch/supertext/ping"
      }
    },
    {
      "name": "WordPress upgraded (system version changed)",
      "body": {
        "schema": 1,
        "event": "upgraded",
        "site_url": "https://shop.example.com/de",
        "plugin": {
          "name": "supertext-wordpress-polylang",
          "version": "2.1.0"
        },
        "system": {
          "name": "WordPress",
          "version": "6.9.0"
        },
        "runtime": {
          "name": "PHP",
          "version": "8.4.1"
        }
      }
    },
    {
      "name": "Minimal report (only required fields)",
      "body": {
        "schema": 1,
        "event": "installed",
        "site_url": "https://cms.example.org",
        "plugin": {
          "name": "Strapi-Supertext-Translation",
          "version": "0.2.0"
        },
        "system": {
          "name": "Strapi"
        }
      }
    },
    {
      "name": "Unknown event and extra fields are accepted (forward compatible)",
      "body": {
        "schema": 1,
        "event": "nightly_check",
        "site_url": "https://example.net",
        "plugin": {
          "name": "Grav-Supertext-Translation",
          "version": "0.1.0"
        },
        "system": {
          "name": "Grav",
          "version": "2.0.0"
        },
        "languages": [
          "de-CH",
          "fr-CH"
        ]
      }
    },
    {
      "name": "Key rejected during a translation (event api_key_check)",
      "body": {
        "schema": 1,
        "event": "api_key_check",
        "site_url": "https://www.example.ch",
        "plugin": {
          "name": "Contao-Supertext-Translation",
          "version": "0.3.1"
        },
        "system": {
          "name": "Contao",
          "version": "5.7.1"
        },
        "runtime": {
          "name": "PHP",
          "version": "8.3.12"
        },
        "api_key_configured": true,
        "api_key_check": {
          "status": "invalid",
          "checked_at": "2026-10-13T10:02:11Z",
          "http_status": 401,
          "error_code": "INVALID_API_KEY"
        }
      },
      "stored": {
        "api_key_check": {
          "status": "invalid",
          "checked_at": "2026-10-13T10:02:11.000Z",
          "http_status": 401,
          "error_code": "INVALID_API_KEY"
        }
      }
    },
    {
      "name": "Supertext unreachable, no checked_at (the center uses the receive time)",
      "body": {
        "schema": 1,
        "event": "settings_saved",
        "site_url": "https://cms.example.org",
        "plugin": {
          "name": "Strapi-Supertext-Translation",
          "version": "0.2.0"
        },
        "system": {
          "name": "Strapi",
          "version": "5.12.0"
        },
        "api_key_configured": true,
        "api_key_check": {
          "status": "unreachable"
        }
      },
      "stored": {
        "api_key_check": {
          "status": "unreachable",
          "checked_at": "<receive time>",
          "http_status": null,
          "error_code": null
        }
      }
    },
    {
      "name": "Malformed api_key_check is ignored, the rest is stored",
      "body": {
        "schema": 1,
        "event": "settings_saved",
        "site_url": "https://cms.example.net",
        "plugin": {
          "name": "Strapi-Supertext-Translation",
          "version": "0.2.0"
        },
        "system": {
          "name": "Strapi"
        },
        "api_key_check": {
          "status": "Not OK!",
          "http_status": "401"
        }
      },
      "stored": {
        "api_key_check": null
      }
    },
    {
      "name": "Malformed callback is ignored, the rest is stored",
      "body": {
        "schema": 1,
        "event": "settings_saved",
        "site_url": "https://www.example.org",
        "plugin": {
          "name": "Joomla-Supertext-Translation",
          "version": "0.2.0"
        },
        "system": {
          "name": "Joomla",
          "version": "5.3.0"
        },
        "callback": {
          "url": "javascript:alert(1)"
        }
      },
      "stored": {
        "api_key_check": null,
        "callback_url": null
      }
    },
    {
      "name": "WordPress with three named keys, one rejected",
      "body": {
        "schema": 1,
        "event": "settings_saved",
        "site_url": "https://blog.example.ch/",
        "plugin": { "name": "supertext-wordpress-polylang", "version": "2.1.0" },
        "system": { "name": "WordPress", "version": "6.9" },
        "runtime": { "name": "PHP", "version": "8.3.12" },
        "sdk_version": "0.5.0",
        "api_keys": [
          { "name": "AI translation", "configured": true, "check": { "status": "ok", "checked_at": "2026-10-13T09:15:00+02:00", "http_status": 200 } },
          { "name": "Professional orders", "configured": true, "check": { "status": "invalid", "checked_at": "2026-10-13T09:15:01+02:00", "http_status": 401, "error_code": "UNAUTHORIZED" } },
          { "name": "Review", "configured": false, "check": { "status": "missing", "checked_at": "2026-10-13T09:15:01+02:00" } }
        ]
      },
      "stored": {
        "api_key_configured": true,
        "api_key_check": { "status": "invalid", "checked_at": "2026-10-13T07:15:01.000Z", "http_status": 401, "error_code": "UNAUTHORIZED" },
        "api_keys": [
          { "name": "AI translation", "configured": true, "status": "ok", "checked_at": "2026-10-13T07:15:00.000Z", "http_status": 200, "error_code": null },
          { "name": "Professional orders", "configured": true, "status": "invalid", "checked_at": "2026-10-13T07:15:01.000Z", "http_status": 401, "error_code": "UNAUTHORIZED" },
          { "name": "Review", "configured": false, "status": "missing", "checked_at": "2026-10-13T07:15:01.000Z", "http_status": null, "error_code": null }
        ]
      }
    },
    {
      "name": "api_keys wins over the single-key fields; malformed and duplicate entries are dropped",
      "body": {
        "schema": 1,
        "event": "check",
        "site_url": "https://shop.example.ch",
        "plugin": { "name": "Magento-Supertext-Translation", "version": "0.6.0" },
        "system": { "name": "Magento" },
        "api_key_configured": false,
        "api_key_check": { "status": "missing" },
        "api_keys": [
          { "name": "Store view DE", "configured": true, "check": { "status": "ok", "checked_at": "2026-10-13T08:00:00Z" } },
          { "name": "Store view DE", "configured": false },
          { "name": "" },
          "text",
          { "name": "Store view FR", "configured": true, "check": { "status": "Not OK!" } }
        ]
      },
      "stored": {
        "api_key_configured": true,
        "api_key_check": { "status": "ok", "checked_at": "2026-10-13T08:00:00.000Z", "http_status": null, "error_code": null },
        "api_keys": [
          { "name": "Store view DE", "configured": true, "status": "ok", "checked_at": "2026-10-13T08:00:00.000Z", "http_status": null, "error_code": null },
          { "name": "Store view FR", "configured": true, "status": null, "checked_at": null, "http_status": null, "error_code": null }
        ]
      }
    },
    {
      "name": "Empty api_keys: the plugin reports no keys",
      "body": {
        "schema": 1,
        "event": "installed",
        "site_url": "https://cms.example.ch",
        "plugin": { "name": "Neos-Supertext-Translation", "version": "0.3.0" },
        "system": { "name": "Neos" },
        "api_keys": []
      },
      "stored": { "api_key_configured": false, "api_key_check": null, "api_keys": [] }
    },
    {
      "name": "The other plugins installed on the site (event extensions, sent with the plugin's button)",
      "body": {
        "schema": 1,
        "event": "extensions",
        "site_url": "https://blog.example.ch/",
        "plugin": { "name": "supertext-wordpress-polylang", "version": "2.1.0" },
        "system": { "name": "WordPress", "version": "6.9" },
        "runtime": { "name": "PHP", "version": "8.3.12" },
        "extensions": [
          { "name": "Polylang Pro", "version": "3.7.2", "active": true, "type": "plugin" },
          { "name": "Yoast SEO", "version": "24.1", "active": true, "type": "plugin" },
          { "name": "Akismet Anti-spam", "version": "5.3", "active": false, "type": "plugin" },
          { "name": "Twenty Twenty-Five", "version": "1.2", "active": true, "type": "theme" }
        ]
      },
      "stored": {
        "api_key_check": null,
        "extensions": [
          { "name": "Polylang Pro", "version": "3.7.2", "active": true, "type": "plugin" },
          { "name": "Yoast SEO", "version": "24.1", "active": true, "type": "plugin" },
          { "name": "Akismet Anti-spam", "version": "5.3", "active": false, "type": "plugin" },
          { "name": "Twenty Twenty-Five", "version": "1.2", "active": true, "type": "theme" }
        ]
      }
    },
    {
      "name": "Installed plugins: malformed entries and duplicates are dropped, a malformed version or type becomes null",
      "body": {
        "schema": 1,
        "event": "extensions",
        "site_url": "https://shop.example.ch",
        "plugin": { "name": "Magento-Supertext-Translation", "version": "0.4.0" },
        "system": { "name": "Magento Open Source", "version": "2.4.8" },
        "extensions": [
          { "name": "Mageplaza_Smtp", "version": "4.7.4", "active": true, "type": "module" },
          { "name": "mageplaza_smtp", "version": "4.7.5", "type": "module" },
          { "name": "  ", "version": "1.0" },
          { "version": "1.0" },
          "Amasty_Base",
          { "name": "Hyva_Theme", "version": 3, "active": "yes", "type": "Theme!" }
        ]
      },
      "stored": {
        "api_key_check": null,
        "extensions": [
          { "name": "Mageplaza_Smtp", "version": "4.7.4", "active": true, "type": "module" },
          { "name": "Hyva_Theme", "version": null, "active": null, "type": null }
        ]
      }
    }
  ],
